NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Canonical app origin; required for OAuth in production. Use the same host
# throughout the flow (localhost and 127.0.0.1 have separate cookies).
SITE_URL=http://127.0.0.1:3000
# Enable only after the Supabase Magic Link template contains {{ .Token }}
# and delivery/rate limits have been verified.
EMAIL_OTP_ENABLED=false

# Server-side Resend configuration for application emails and webhooks (#34, #33).
# NEVER prefix these with NEXT_PUBLIC_. Keep restricted to server-side runtimes.
# Account emails (OTP/confirmation/recovery) use Supabase Auth SMTP directly.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="AlumniKonneQt <notifications@auth.alumnikonneqt.com>"
# EMAIL_DELIVERY_MODE="mock" # "live" | "mock" | "suppress" (defaults to mock in test)
# EMAIL_ALLOWED_DOMAINS="example.test,auth.alumnikonneqt.com" # non-production safety guard
# Local Supabase CLI provider credentials. Never prefix secrets with NEXT_PUBLIC_.
# Export these in the shell used to start Supabase, then enable the Google provider.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
